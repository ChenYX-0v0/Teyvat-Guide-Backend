DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=demo_project

SMS_PROVIDER=mock
SMS_CODE_HMAC_SECRET=replace-with-at-least-32-random-characters

# 多项目网关凭证（命名规则：PROJECT_<项目 code 大写下划线>_ADMIN_KEY）
# teyvatGuide 管理接口的 X-Admin-Key（当前取其 config.yaml 的 auth.jwt_secret）
PROJECT_TEYVAT_GUIDE_ADMIN_KEY=

# AI 派蒙服务的 X-AI-Key（值 = teyvat-ai 的 AI_SERVICE_KEY；仅用于运维探测/试调）
PROJECT_TEYVAT_AI_ADMIN_KEY=

# teyvatGuide 内网管理接口密钥（X-Internal-Key，独立于 X-Admin-Key / 用户 JWT）
# 用于后台「用户管理」等服务端直连内网接口，值需与主服务内部接口密钥一致
PROJECT_TEYVAT_GUIDE_INTERNAL_KEY=

# teyvatGuide 业务库直连（缺省复用上面的 DB_* 与 127.0.0.1:3306）
TEYVAT_DB_HOST=127.0.0.1
TEYVAT_DB_PORT=3306
TEYVAT_DB_USER=root
TEYVAT_DB_PASSWORD=root
TEYVAT_DB_NAME=teyvat_guide
